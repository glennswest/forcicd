# Copy to proxmox.env (gitignored) and adjust.
# Defaults match the g8.lo lab.

PVE_HOST=root@pve.g8.lo
PVE_STORAGE=local-lvm
PVE_BRIDGE=vmbr0
PVE_IMG=/var/lib/vz/template/iso/Fedora-Cloud-Base-Generic-43-1.6.x86_64.qcow2
PVE_SNIPPETS=/var/lib/vz/snippets

# Target VM.
VMID=115
VM_NAME=forcicd.g8.lo
VM_IP=192.168.8.154
VM_DISK_GB=64
VM_MEMORY_MB=8192
VM_CORES=4

# Fastetcd repo to mirror.
UPSTREAM_REPO_URL=https://github.com/glennswest/fastetcd.git
UPSTREAM_REPO_OWNER=glennswest
UPSTREAM_REPO_NAME=fastetcd

# Forgejo admin to create on first bootstrap.
FORGEJO_ADMIN_USER=ci
FORGEJO_ADMIN_EMAIL=ci@g8.lo
# Password is generated by bootstrap.sh and saved to
# build/admin-password on the local machine (gitignored).

# DNS — same MicroDNS the other projects use.
MICRODNS_URL=http://192.168.8.252:8080/api/v1
G8_ZONE_ID=9bed60c8-1664-4183-88f9-a1a21b927edc

# Image registry for CI output (mkube).
LOCAL_REGISTRY=fastregistry.g10.lo
