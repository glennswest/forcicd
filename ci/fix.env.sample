# forcicd auto-fix config — copy to /etc/forcicd/fix.env on the VM.
#
# The Claude client is YOUR piece: set CLAUDE_CMD to however you
# invoke it headlessly, and make it available in the throwaway env
# (mount it for docker, or bake it into the LXC template).

# ---- compute backend ---------------------------------------------
# docker = throwaway container on the forcicd VM (works out of the
#          box with the runner images).
# lxc    = throwaway CT on pve.g8.lo cloned from a prebuilt template
#          (preferred: full system, persistent claude index, etc.).
FIX_BACKEND='docker'

# ---- the Claude hook ---------------------------------------------
# Runs inside the throwaway env (cwd /work = the repo clone). Gets
# the task brief on stdin and at /work/TASK.md. For `fixit` it must
# iterate to green and write a full root-cause + fix explanation to
# /work/FIX_WRITEUP.md (posted to the issue verbatim).
# Recommended: plain headless Claude in danger mode (the env is a
# throwaway clone of ONLY the issue's repo, so skipping permission
# prompts is safe). It reads the brief on stdin and writes the fix
# explanation to /work/FIX_WRITEUP.md (posted to the issue verbatim).
#   CLAUDE_CMD='claude -p --dangerously-skip-permissions --max-turns 200'
#   CLAUDE_CMD='claude code --headless --task-file /work/TASK.md'
# Empty = build-only (no fix attempt) until you wire it.
CLAUDE_CMD='claude -p --dangerously-skip-permissions --max-turns 200'

# ---- docker backend knobs ----------------------------------------
# Image the fix runs in. Bake claude + git + vi in, or mount them:
#   FIX_MOUNTS='-v /opt/claude:/usr/local/bin/claude:ro \
#               -v /etc/forcicd/claude-home:/root/.claude'
# The claude history/indexing add-on keeps its index under the
# mounted claude-home so it persists across runs.
# FIX_IMAGE='forcicd.g8.lo:5000/forcicd-runner-ubuntu22:latest'
FIX_MOUNTS=''

# ---- lxc backend knobs -------------------------------------------
# CT id of a prebuilt template with git + vi + claude + the claude
# indexing add-on + build toolchain. Build it once (claude is big —
# give the template plenty of disk) and set its id here. The worker
# `pct clone`s it per fix and destroys the clone after.
#   PVE_HOST='root@pve.g8.lo'
#   FIX_LXC_TEMPLATE='9000'
#   FIX_LXC_STORAGE='local-lvm'
FIX_LXC_TEMPLATE=''

# ---- behaviour ---------------------------------------------------
# Auto-detected from the repo if unset (Cargo.toml→cargo, go.mod→go,
# Makefile→make).
# BUILD_CMD='cargo test --all'

# fixit: on a green build, also push the fix to a branch + open a PR
# (the issue is commented + closed regardless). Default false.
FIX_PUSH='false'

# Safety cap on a single autonomous attempt (minutes).
FIX_MAX_MINUTES='120'
