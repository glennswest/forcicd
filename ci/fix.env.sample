# forcicd auto-fix config — copy to /etc/forcicd/fix.env on the VM.
#
# The Claude client is YOUR piece: set CLAUDE_CMD to however you
# invoke it headlessly, and mount its binary + your subscription
# auth into the throwaway container via FIX_MOUNTS.

# How to run your Claude client inside the fix container. It gets
# the task brief on stdin and at /work/TASK.md, and should edit the
# working tree in place. Examples:
#   CLAUDE_CMD='claude -p --dangerously-skip-permissions --max-turns 50'
#   CLAUDE_CMD='claude code --headless --task-file /work/TASK.md'
# Leave empty to run build-only (no fix attempt) until you wire it.
CLAUDE_CMD=''

# Extra `docker run` mounts to bring your claude binary + auth into
# the container. Examples:
#   FIX_MOUNTS='-v /opt/claude:/usr/local/bin/claude:ro -v /etc/forcicd/claude-home:/root/.claude:ro'
# Or bake claude into a custom FIX_IMAGE instead.
FIX_MOUNTS=''

# Container the fix runs in (needs the repo's toolchain). Defaults
# to the ubuntu runner image.
# FIX_IMAGE='forcicd.g8.lo:5000/forcicd-runner-ubuntu22:latest'

# Build cycle after the fix attempt (auto-detected from the repo
# if left unset: Cargo.toml→cargo, go.mod→go, Makefile→make).
# BUILD_CMD='cargo test --all'

# Open a PR with the fix instead of only commenting (default false).
FIX_PUSH='false'

# Hard cap on a single fix attempt.
FIX_MAX_MINUTES='30'
