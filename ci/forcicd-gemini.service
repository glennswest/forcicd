[Unit]
Description=forcicd — Gemini code review of new pushes → local Forgejo issues
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/forcicd/gemini-review.py
Environment=FORGEJO_URL=http://localhost:3000
# Optional knobs (uncomment to override defaults):
#Environment=GEMINI_MODEL=gemini-2.5-flash
#Environment=REVIEW_DIFF_MAX_CHARS=60000
#Environment=GEMINI_BIN=/usr/local/bin/gemini
StandardOutput=journal
StandardError=journal
