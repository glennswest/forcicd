# forcicd-runner — act-compatible runner image with the toolchains
# fastetcd (and siblings) need:
#
#   * Rust stable + aarch64 + x86_64 musl targets
#   * Go (cross-compile-capable; CGO_ENABLED off by default for portability)
#   * C: gcc, clang, gcc-aarch64-linux-gnu, libc6-dev cross headers
#   * Kernel build prereqs: make, bc, flex, bison, libssl-dev, libelf-dev,
#     kmod, cpio, dwarves, rsync — plus headers for the host kernel
#   * Container plumbing actions need: git, curl, jq, sudo, ca-certificates,
#     gnupg, lsb-release, software-properties-common
#   * Docker CLI + buildx + QEMU registration for multi-arch image builds
#
# Base is catthehacker/ubuntu:full-22.04 which act_runner / Forgejo Actions
# treats as a drop-in for GitHub-hosted ubuntu-22.04. Building on the FULL
# variant means most actions/* run without needing tool-cache misses.

FROM ghcr.io/catthehacker/ubuntu:full-22.04

# The catthehacker base ships USER=runner; apt + rustup need root.
USER root

ARG DEBIAN_FRONTEND=noninteractive
ARG GO_VERSION=1.22.6
ARG RUST_VERSION=stable

# ----- C / cross-compile / kernel build prereqs --------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        lld \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        libc6-dev-arm64-cross \
        linux-libc-dev-arm64-cross \
        crossbuild-essential-arm64 \
        protobuf-compiler \
        pkg-config \
        libssl-dev \
        libelf-dev \
        libudev-dev \
        bc \
        flex \
        bison \
        kmod \
        cpio \
        dwarves \
        rsync \
        bsdmainutils \
        dosfstools \
        device-tree-compiler \
        u-boot-tools \
        qemu-user-static \
        binfmt-support \
        ca-certificates \
        curl \
        wget \
        git \
        jq \
        sudo \
        gnupg \
        lsb-release \
        software-properties-common \
        unzip \
        zip \
        xz-utils \
        zstd \
        podman \
        buildah \
        skopeo \
        fuse-overlayfs \
        uidmap \
    && rm -rf /var/lib/apt/lists/*

# ----- rootless container builds inside the runner ----------------
# Jobs run inside a container that's already on overlayfs, so
# podman/buildah's default `overlay` driver fails ("not supported
# over overlayfs"). fuse-overlayfs as the mount_program makes
# nested overlay work — so `podman build` / `buildah bud` succeed
# without privileged mode or a docker daemon. (Closes the
# container-builder gap; qregistry et al. build images in CI.)
RUN mkdir -p /etc/containers && \
    printf '[storage]\ndriver = "overlay"\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' \
        > /etc/containers/storage.conf && \
    printf 'unqualified-search-registries = ["docker.io"]\n[[registry]]\nlocation = "forcicd.g8.lo:5000"\ninsecure = true\n[[registry]]\nlocation = "fastregistry.g10.lo"\ninsecure = true\n' \
        > /etc/containers/registries.conf

# Rootless podman needs a user-owned XDG_RUNTIME_DIR; the
# catthehacker runner runs as uid 1001 and /run/user/1001 isn't
# set up, so podman/skopeo (incl. ones invoked by actions) error
# with "XDG_RUNTIME_DIR not owned". Give it a stable owned dir.
ENV XDG_RUNTIME_DIR=/tmp/podman-run-1001
RUN mkdir -p /tmp/podman-run-1001 && chown 1001:1001 /tmp/podman-run-1001 && chmod 700 /tmp/podman-run-1001

# ----- Kernel headers for the host kernel (x86) --------------------
# Generic 5.x headers — actual driver builds in CI use linux-headers-$(uname -r)
# but for a runner container the generic package is what's available.
RUN apt-get update && apt-get install -y --no-install-recommends \
        linux-headers-generic \
    && rm -rf /var/lib/apt/lists/*

# ----- Rust ---------------------------------------------------------
ENV RUSTUP_HOME=/opt/rust \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/go/bin:${PATH}
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
        --default-toolchain ${RUST_VERSION} \
        --profile minimal \
    && /opt/cargo/bin/rustup component add rustfmt clippy \
    && /opt/cargo/bin/rustup target add \
        aarch64-unknown-linux-gnu \
        aarch64-unknown-linux-musl \
        x86_64-unknown-linux-musl \
    && chmod -R a+rwX /opt/cargo /opt/rust

# Configure cargo to use the aarch64-linux-gnu linker for that target.
RUN mkdir -p /opt/cargo \
    && printf '[target.aarch64-unknown-linux-gnu]\nlinker = "aarch64-linux-gnu-gcc"\n[target.aarch64-unknown-linux-musl]\nlinker = "aarch64-linux-gnu-gcc"\n' \
        > /opt/cargo/config.toml

# ----- Go -----------------------------------------------------------
RUN ARCH=$(dpkg --print-architecture) \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz" \
        | tar -C /usr/local -xz \
    && go version

# ----- Docker CLI + buildx -----------------------------------------
# (The host docker socket is mounted in by act_runner; we only need
# the client + buildx plugin inside.)
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        docker-ce-cli \
        docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/*

# ----- Sanity check -------------------------------------------------
RUN rustc --version \
    && cargo --version \
    && go version \
    && gcc --version \
    && aarch64-linux-gnu-gcc --version \
    && docker --version \
    && docker buildx version

# Default workdir for actions/checkout
WORKDIR /workspace
