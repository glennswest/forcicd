# forcicd-runner-rhel8 — UBI 8. See Dockerfile.ubi9 for the same
# reduced-toolchain rationale. Targets OCP 4.7 → 4.12.

FROM registry.access.redhat.com/ubi8/ubi:latest

ARG GO_VERSION=1.22.6
ARG RUST_VERSION=stable

RUN dnf -y install \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm \
    && dnf -y update

RUN dnf install -y --allowerasing --setopt=install_weak_deps=False \
        gcc gcc-c++ clang \
        make automake autoconf libtool pkgconf-pkg-config \
        openssl-devel \
        bc \
        kmod cpio rsync \
        zstd xz tar zip unzip \
        git curl wget jq sudo which gnupg2 \
        ca-certificates \
        python3 python3-pip \
        skopeo buildah podman fuse-overlayfs \
    && dnf clean all

ENV RUSTUP_HOME=/opt/rust \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/go/bin:${PATH}
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
        --default-toolchain ${RUST_VERSION} \
        --profile minimal \
    && /opt/cargo/bin/rustup component add rustfmt clippy \
    && /opt/cargo/bin/rustup target add \
        aarch64-unknown-linux-musl \
        x86_64-unknown-linux-musl \
    && chmod -R a+rwX /opt/cargo /opt/rust

RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz" \
        | tar -C /usr/local -xz \
    && go version

RUN dnf config-manager --add-repo \
        https://download.docker.com/linux/centos/docker-ce.repo \
    && dnf install -y --setopt=install_weak_deps=False \
        docker-ce-cli \
        docker-buildx-plugin \
    && dnf clean all

RUN rustc --version \
    && cargo --version \
    && go version \
    && gcc --version \
    && docker --version


# Rootless container builds inside the runner: nested overlay needs
# fuse-overlayfs as the mount_program (jobs run on overlayfs).
RUN mkdir -p /etc/containers && \
    printf '[storage]\ndriver = "overlay"\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' > /etc/containers/storage.conf && \
    printf 'unqualified-search-registries = ["docker.io"]\n[[registry]]\nlocation = "forcicd.g8.lo:5000"\ninsecure = true\n[[registry]]\nlocation = "fastregistry.g10.lo"\ninsecure = true\n' > /etc/containers/registries.conf

WORKDIR /workspace
