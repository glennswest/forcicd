# forcicd-runner-bootc — CentOS Stream 9 bootc base.
#
# For jobs that build or test bootc (bootable-container) artifacts.
# Uses the official bootc base so the in-container `bootc` CLI is
# already present and matches what produced RHCOS-bootc / CoreOS-bootc
# in production. The bootc-image-builder utility is pulled by jobs
# via `docker run quay.io/centos-bootc/bootc-image-builder` — the
# runner just needs docker access (mounted in by act_runner).

FROM quay.io/centos-bootc/centos-bootc:stream9

ARG GO_VERSION=1.22.6
ARG RUST_VERSION=stable

# The bootc base is OS-style, not a typical builder image, so we
# add the toolchain set on top.
RUN dnf install -y \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
    && dnf -y update

RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ clang lld \
        gcc-aarch64-linux-gnu \
        protobuf-compiler \
        make automake autoconf libtool pkgconf-pkg-config \
        openssl-devel \
        elfutils-libelf-devel \
        bc flex bison \
        kmod cpio dwarves rsync \
        zstd xz tar zip unzip \
        git curl wget jq sudo which gnupg2 \
        ca-certificates \
        qemu-user-static qemu-img \
        kernel-headers kernel-devel \
        python3 python3-pip \
        skopeo buildah podman \
    && dnf clean all

# Confirm bootc CLI is present (comes with the base) and grab the
# bootc-image-builder helper so jobs that produce disk/ISO/qcow2
# from bootc images can run it offline.
RUN bootc --version || true

ENV RUSTUP_HOME=/opt/rust \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/go/bin:${PATH}
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
        --default-toolchain ${RUST_VERSION} \
        --profile minimal \
    && /opt/cargo/bin/rustup component add rustfmt clippy \
    && /opt/cargo/bin/rustup target add \
        aarch64-unknown-linux-gnu \
        aarch64-unknown-linux-musl \
        x86_64-unknown-linux-musl \
    && chmod -R a+rwX /opt/cargo /opt/rust \
    && mkdir -p /opt/cargo \
    && printf '[target.aarch64-unknown-linux-gnu]\nlinker = "aarch64-linux-gnu-gcc"\n[target.aarch64-unknown-linux-musl]\nlinker = "aarch64-linux-gnu-gcc"\n' \
        > /opt/cargo/config.toml

RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz" \
        | tar -C /usr/local -xz \
    && go version

# Docker CLI + buildx for jobs that prefer docker over podman.
RUN dnf config-manager --add-repo \
        https://download.docker.com/linux/centos/docker-ce.repo \
    && dnf install -y --setopt=install_weak_deps=False \
        docker-ce-cli \
        docker-buildx-plugin \
    && dnf clean all

RUN rustc --version \
    && cargo --version \
    && go version \
    && gcc --version \
    && aarch64-linux-gnu-gcc --version \
    && podman --version \
    && skopeo --version \
    && buildah --version \
    && docker --version

WORKDIR /workspace
