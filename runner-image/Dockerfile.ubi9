# forcicd-runner-rhel9 — UBI 9.
#
# Targets OCP 4.13 → 4.18 / current-stable. RHCOS tracks RHEL 9.x.
#
# Reduced toolchain: UBI without RHEL subscription doesn't carry
# flex/bison/dwarves/protobuf-compiler/kernel-devel/qemu-user-static
# nor gcc-aarch64-linux-gnu. Those live in full RHEL CRB only —
# not in UBI's CRB clone, and not in EPEL. For jobs that need
# them, target ubuntu22, debian12, fedora43, or bootc. UBI here
# still gives you:
#   * native gcc/clang + rust (with x86_64/aarch64 musl targets,
#     which use rust-lld and don't need an external C cross-linker)
#   * go (cross-compile via GOARCH; pure-go works fine)
#   * make/autoconf
#   * podman/skopeo/buildah + docker CLI
# Useful for verifying rust/go/C/container builds on RHEL libc.

FROM registry.access.redhat.com/ubi9/ubi:latest

ARG GO_VERSION=1.22.6
ARG RUST_VERSION=stable

RUN dnf -y install \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
    && dnf -y update

RUN dnf install -y --allowerasing --setopt=install_weak_deps=False \
        gcc gcc-c++ clang lld \
        make automake autoconf libtool pkgconf-pkg-config \
        openssl-devel \
        elfutils-libelf-devel \
        bc \
        kmod cpio rsync \
        zstd xz tar zip unzip \
        git curl wget jq sudo which gnupg2 \
        ca-certificates \
        python3 python3-pip \
        skopeo buildah podman \
    && dnf clean all

ENV RUSTUP_HOME=/opt/rust \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/go/bin:${PATH}
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
        --default-toolchain ${RUST_VERSION} \
        --profile minimal \
    && /opt/cargo/bin/rustup component add rustfmt clippy \
    && /opt/cargo/bin/rustup target add \
        aarch64-unknown-linux-musl \
        x86_64-unknown-linux-musl \
    && chmod -R a+rwX /opt/cargo /opt/rust

RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz" \
        | tar -C /usr/local -xz \
    && go version

RUN dnf config-manager --add-repo \
        https://download.docker.com/linux/centos/docker-ce.repo \
    && dnf install -y --setopt=install_weak_deps=False \
        docker-ce-cli \
        docker-buildx-plugin \
    && dnf clean all

RUN rustc --version \
    && cargo --version \
    && go version \
    && gcc --version \
    && docker --version

WORKDIR /workspace
