# forcicd-runner-rhel9 — UBI 9 + the UBI-CRB repo (which is the
# free mirror of the CRB packages: protobuf-compiler, flex, bison,
# dwarves, etc.). No Red Hat subscription required.
#
# A few packages stay subscription-only and are simply omitted:
#   - kernel-devel / kernel-headers (RHEL Server only)
#   - qemu-user-static (RHEL Server only; EPEL has qemu-system-*)
#   - bootc (RHEL 9.4+ Server only)
# Jobs that need those should target the bootc or fedora43 runner.

FROM registry.access.redhat.com/ubi9/ubi:latest

ARG GO_VERSION=1.22.6
ARG RUST_VERSION=stable

# UBI ships with BaseOS + AppStream. Enabling the UBI CRB repo
# unlocks build-time packages without subscription, and EPEL fills
# the rest.
RUN dnf -y install \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
    && dnf config-manager --set-enabled ubi-9-codeready-builder-rpms 2>/dev/null \
        || dnf config-manager --enablerepo='*codeready*' 2>/dev/null || true \
    && dnf -y update

RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ clang lld \
        gcc-aarch64-linux-gnu \
        protobuf-compiler \
        make automake autoconf libtool pkgconf-pkg-config \
        openssl-devel \
        elfutils-libelf-devel \
        bc flex bison \
        kmod cpio dwarves rsync \
        zstd xz tar zip unzip \
        git curl wget jq sudo which gnupg2 \
        ca-certificates \
        python3 python3-pip \
        skopeo buildah podman \
    && dnf clean all

ENV RUSTUP_HOME=/opt/rust \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/go/bin:${PATH}
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
        --default-toolchain ${RUST_VERSION} \
        --profile minimal \
    && /opt/cargo/bin/rustup component add rustfmt clippy \
    && /opt/cargo/bin/rustup target add \
        aarch64-unknown-linux-gnu \
        aarch64-unknown-linux-musl \
        x86_64-unknown-linux-musl \
    && chmod -R a+rwX /opt/cargo /opt/rust \
    && mkdir -p /opt/cargo \
    && printf '[target.aarch64-unknown-linux-gnu]\nlinker = "aarch64-linux-gnu-gcc"\n[target.aarch64-unknown-linux-musl]\nlinker = "aarch64-linux-gnu-gcc"\n' \
        > /opt/cargo/config.toml

RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz" \
        | tar -C /usr/local -xz \
    && go version

RUN dnf config-manager --add-repo \
        https://download.docker.com/linux/centos/docker-ce.repo \
    && dnf install -y --setopt=install_weak_deps=False \
        docker-ce-cli \
        docker-buildx-plugin \
    && dnf clean all

RUN rustc --version \
    && cargo --version \
    && go version \
    && gcc --version \
    && aarch64-linux-gnu-gcc --version \
    && docker --version

WORKDIR /workspace
